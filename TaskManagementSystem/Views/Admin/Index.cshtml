@model TaskManagementSystem.BL.DTOs.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Task Dashboard";
}

<div class="container-fluid px-3 px-md-4">
    <!-- Top Header & Action Controls -->
    <div class="row align-items-center justify-content-between mb-4 gy-3">
        <div class="col-12 col-md-auto">
            <h2 class="h3 fw-bold mb-1 text-dark d-flex align-items-center">
                <i class="bi bi-card-checklist text-primary me-2"></i>Task Submissions
            </h2>
            <p class="text-muted mb-0 small">Real-time overview, inline editing, and dynamic Excel reporting for employee task submissions.</p>
        </div>
        <div class="col-12 col-md-auto d-flex align-items-center flex-wrap gap-2">
            <span class="badge bg-secondary fs-6 py-2 px-3 shadow-sm d-flex align-items-center" id="totalTasksBadge">
                <i class="bi bi-stack me-2"></i>Total Tasks: <strong class="ms-1" id="totalCountNumber">@Model.TotalCount</strong>
            </span>
            <a class="btn btn-excel d-flex align-items-center shadow-sm"
               id="exportExcelBtn"
               asp-controller="Admin"
               asp-action="Export"
               asp-route-userId="@Model.SelectedUserId"
               asp-route-period="@Model.SelectedPeriod"
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))">
                <i class="bi bi-file-earmark-excel-fill me-2 fs-5"></i> Export to Excel
            </a>
        </div>
    </div>

    <!-- Interactive Filters Section -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel-fill text-primary fs-5"></i>
                <h5 class="card-title mb-0 fw-semibold text-secondary">Dynamic Filters</h5>
                <span class="badge bg-light text-muted border ms-1 small fw-normal">Instant Refresh</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm d-flex align-items-center" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
        </div>
        <div class="card-body bg-light-subtle">
            <form id="filterForm" method="get" asp-controller="Admin" asp-action="Index" class="row g-3">
                <!-- User Filter -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="userId" class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-person me-1"></i>Employee / User
                    </label>
                    <select id="userId" name="userId" class="form-select auto-filter">
                        <option value="">-- All Users --</option>
                        @foreach (var user in Model.Users)
                        {
                            if (Model.SelectedUserId == user.Id)
                            {
                                <option value="@user.Id" selected="selected">@user.FullName (@user.Email)</option>
                            }
                            else
                            {
                                <option value="@user.Id">@user.FullName (@user.Email)</option>
                            }
                        }
                    </select>
                </div>

                <!-- Period Filter Preset -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="period" class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-clock-history me-1"></i>Quick Timeframe
                    </label>
                    <select id="period" name="period" class="form-select auto-filter">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedPeriod))">-- All Time / Custom --</option>
                        <option value="week" selected="@(Model.SelectedPeriod == "week")">Last Week (Past 7 Days)</option>
                        <option value="month" selected="@(Model.SelectedPeriod == "month")">Last Month (Past 30 Days)</option>
                        <option value="year" selected="@(Model.SelectedPeriod == "year")">Last Year</option>
                        <option value="all" selected="@(Model.SelectedPeriod == "all")">All Recorded Time</option>
                    </select>
                </div>

                <!-- From Date -->
                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="fromDate" class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-calendar-event me-1"></i>From Date
                    </label>
                    <input type="date" id="fromDate" name="fromDate" class="form-control auto-filter"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- To Date -->
                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="toDate" class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-calendar-check me-1"></i>To Date
                    </label>
                    <input type="date" id="toDate" name="toDate" class="form-control auto-filter"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- Live Search Box (Client-side fast search) -->
                <div class="col-12 col-lg-2">
                    <label for="clientSearch" class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-search me-1"></i>Live Search
                    </label>
                    <input type="text" id="clientSearch" class="form-control" placeholder="Search table..." autocomplete="off" />
                </div>
            </form>
        </div>
    </div>

    <!-- Tasks Data Table Card with Loading Overlay -->
    <div class="card shadow-sm border-0 position-relative overflow-hidden" id="tasksCard">
        <!-- Subtle AJAX Loading Overlay -->
        <div id="loadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center"
             style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(2px); z-index: 10;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading tasks...</span>
            </div>
        </div>

        <div class="card-body p-0" id="tasksContainer">
            @await Html.PartialAsync("_TasksTablePartial", Model)
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- EDIT TASK MODAL                           -->
<!-- ========================================== -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-labelledby="editTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="editTaskModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Task #<span id="modalTaskIdText"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalAlert" class="alert alert-danger d-none" role="alert"></div>

                <form id="editTaskForm">
                    <input type="hidden" id="editTaskId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">
                                <i class="bi bi-person me-1"></i>Employee (Author)
                            </label>
                            <input type="text" id="editTaskUser" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="editTaskDate" class="form-label fw-semibold small text-secondary">
                                <i class="bi bi-calendar-event me-1"></i>When Did They Do It (Task Date) *
                            </label>
                            <input type="datetime-local" id="editTaskDate" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editTaskTitle" class="form-label fw-semibold small text-secondary">
                            <i class="bi bi-tag me-1"></i>Task Title (Optional)
                        </label>
                        <input type="text" id="editTaskTitle" class="form-control" placeholder="Optional brief title..." maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label for="editTaskDesc" class="form-label fw-semibold small text-secondary">
                            <i class="bi bi-card-text me-1"></i>Task Description *
                        </label>
                        <textarea id="editTaskDesc" class="form-control" rows="5" placeholder="Enter task details..." required maxlength="4000"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveEditTaskBtn" class="btn btn-primary d-flex align-items-center">
                    <span id="saveBtnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                    <i class="bi bi-check-lg me-1" id="saveBtnIcon"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ACTION TOAST NOTIFICATION                  -->
<!-- ========================================== -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
    <div id="actionToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <span id="toastMessage">Task updated successfully!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const userIdSelect = document.getElementById('userId');
            const periodSelect = document.getElementById('period');
            const fromDateInput = document.getElementById('fromDate');
            const toDateInput = document.getElementById('toDate');
            const clientSearchInput = document.getElementById('clientSearch');
            const resetBtn = document.getElementById('resetFiltersBtn');
            const exportBtn = document.getElementById('exportExcelBtn');
            const tasksContainer = document.getElementById('tasksContainer');
            const loadingOverlay = document.getElementById('loadingOverlay');
            const totalCountNumber = document.getElementById('totalCountNumber');

            // Modal elements
            const editModalEl = document.getElementById('editTaskModal');
            const editModal = new bootstrap.Modal(editModalEl);
            const modalTaskIdText = document.getElementById('modalTaskIdText');
            const editTaskId = document.getElementById('editTaskId');
            const editTaskUser = document.getElementById('editTaskUser');
            const editTaskTitle = document.getElementById('editTaskTitle');
            const editTaskDate = document.getElementById('editTaskDate');
            const editTaskDesc = document.getElementById('editTaskDesc');
            const modalAlert = document.getElementById('modalAlert');
            const saveEditTaskBtn = document.getElementById('saveEditTaskBtn');
            const saveBtnSpinner = document.getElementById('saveBtnSpinner');
            const saveBtnIcon = document.getElementById('saveBtnIcon');

            // Toast element
            const toastEl = document.getElementById('actionToast');
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            const toastMessage = document.getElementById('toastMessage');

            let activeController = null;

            // Trigger immediate refresh on any filter change
            document.querySelectorAll('.auto-filter').forEach(el => {
                el.addEventListener('change', function () {
                    // If user selects a quick preset, clear explicit date pickers
                    if (this === periodSelect && this.value !== '') {
                        fromDateInput.value = '';
                        toDateInput.value = '';
                    }

                    // If user selects an explicit date, clear period preset
                    if ((this === fromDateInput || this === toDateInput) && this.value !== '') {
                        periodSelect.value = '';
                    }

                    executeLiveFilter();
                });
            });

            // Reset filters button
            resetBtn.addEventListener('click', function () {
                userIdSelect.value = '';
                periodSelect.value = '';
                fromDateInput.value = '';
                toDateInput.value = '';
                clientSearchInput.value = '';
                executeLiveFilter();
            });

            // Live instant search (Client-side fast search over visible table rows)
            clientSearchInput.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                const rows = document.querySelectorAll('#tasksTable tbody tr.task-row');
                let matchCount = 0;

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                        matchCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (totalCountNumber) {
                    totalCountNumber.textContent = query === ''
                        ? (document.getElementById('partialTotalCount')?.value || rows.length)
                        : matchCount;
                }
            });

            // Event delegation to open Edit Task Modal
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.edit-task-btn');
                if (!btn) return;

                const taskId = btn.getAttribute('data-id');
                const title = btn.getAttribute('data-title') || '';
                const desc = btn.getAttribute('data-desc') || '';
                const date = btn.getAttribute('data-date') || '';
                const user = btn.getAttribute('data-user') || '';
                const email = btn.getAttribute('data-email') || '';

                modalTaskIdText.textContent = taskId;
                editTaskId.value = taskId;
                editTaskUser.value = `${user} (${email})`;
                editTaskTitle.value = title;
                editTaskDesc.value = desc;
                editTaskDate.value = date;

                modalAlert.classList.add('d-none');
                modalAlert.textContent = '';

                editModal.show();
            });

            // Save Task Changes from Modal
            saveEditTaskBtn.addEventListener('click', function () {
                const id = parseInt(editTaskId.value, 10);
                const title = editTaskTitle.value.trim();
                const description = editTaskDesc.value.trim();
                const taskDate = editTaskDate.value;

                if (!description) {
                    modalAlert.textContent = 'Please enter a task description.';
                    modalAlert.classList.remove('d-none');
                    editTaskDesc.focus();
                    return;
                }

                if (!taskDate) {
                    modalAlert.textContent = 'Please specify when the task was performed.';
                    modalAlert.classList.remove('d-none');
                    editTaskDate.focus();
                    return;
                }

                modalAlert.classList.add('d-none');
                saveBtnSpinner.classList.remove('d-none');
                saveBtnIcon.classList.add('d-none');
                saveEditTaskBtn.disabled = true;

                fetch('/admin/edit-task', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        id: id,
                        title: title || null,
                        description: description,
                        taskDate: taskDate
                    })
                })
                .then(async res => {
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.message || 'Failed to update task.');
                    }
                    return data;
                })
                .then(data => {
                    editModal.hide();
                    toastMessage.textContent = `Task #${id} was updated successfully!`;
                    toast.show();

                    // Refresh table without page reload
                    executeLiveFilter();
                })
                .catch(err => {
                    modalAlert.textContent = err.message || 'An error occurred while saving.';
                    modalAlert.classList.remove('d-none');
                })
                .finally(() => {
                    saveBtnSpinner.classList.add('d-none');
                    saveBtnIcon.classList.remove('d-none');
                    saveEditTaskBtn.disabled = false;
                });
            });

            // Function to perform AJAX filter request with zero full-page reload
            function executeLiveFilter() {
                const params = new URLSearchParams();

                if (userIdSelect.value) params.append('userId', userIdSelect.value);
                if (periodSelect.value) params.append('period', periodSelect.value);
                if (fromDateInput.value) params.append('fromDate', fromDateInput.value);
                if (toDateInput.value) params.append('toDate', toDateInput.value);

                const queryString = params.toString();
                const exportUrl = '/admin/export' + (queryString ? '?' + queryString : '');
                const ajaxUrl = '/admin' + (queryString ? '?' + queryString : '');

                // Update the Export to Excel button href immediately
                if (exportBtn) {
                    exportBtn.href = exportUrl;
                }

                // Update the browser URL without reloading
                window.history.pushState(null, '', ajaxUrl);

                // Cancel previous in-flight request if user is quickly toggling
                if (activeController) {
                    activeController.abort();
                }
                activeController = new AbortController();

                // Show subtle loading overlay
                loadingOverlay.classList.remove('d-none');
                loadingOverlay.classList.add('d-flex');

                fetch(ajaxUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    signal: activeController.signal
                })
                .then(res => {
                    if (!res.ok) throw new Error('Network error loading tasks');
                    return res.text();
                })
                .then(html => {
                    tasksContainer.innerHTML = html;

                    // Sync the total count badge from the partial
                    const partialCount = document.getElementById('partialTotalCount')?.value;
                    if (partialCount !== undefined && totalCountNumber) {
                        totalCountNumber.textContent = partialCount;
                    }

                    // Re-apply client search if user has typed something
                    if (clientSearchInput.value.trim() !== '') {
                        clientSearchInput.dispatchEvent(new Event('input'));
                    }
                })
                .catch(err => {
                    if (err.name !== 'AbortError') {
                        console.error('Filter error:', err);
                    }
                })
                .finally(() => {
                    loadingOverlay.classList.add('d-none');
                    loadingOverlay.classList.remove('d-flex');
                });
            }
        })();
    </script>
}
